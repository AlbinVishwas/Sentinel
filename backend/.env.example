# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=
# Use 'global' for the newest Gemini models (e.g. gemini-3.5-flash); some are not in regional endpoints.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Gemini model the agent uses (override if 3.5-flash is unavailable on your project).
SENTINEL_MODEL=gemini-3.5-flash
# Local dev uses Application Default Credentials (run: gcloud auth application-default login),
# so leave GOOGLE_APPLICATION_CREDENTIALS blank. Set it only when using a service-account key file.
GOOGLE_APPLICATION_CREDENTIALS=

# GitLab
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_INSTANCE_URL=https://gitlab.com
# Repository Sentinel monitors (path_with_namespace). Given to the agent so it
# doesn't waste reasoning steps hunting for the project.
GITLAB_DEFAULT_PROJECT=

# App — operational ceiling for the ReAct loop (Risk 2). A full fix is ~6 LLM calls;
# 10 leaves headroom while still halting runaway loops. The abort path is demonstrable
# per-request (Test Case 4 can pass max_iterations=5).
MAX_ITERATIONS=10
